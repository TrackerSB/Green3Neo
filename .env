BUILD_DB_PROTOCOL=postgres
# NOTE 2026-04-02: Using "localhost" does not work since the MySQL docker container works with TCP only
BUILD_DB_HOST=127.0.0.1
# NOTE 2026-07-29: Use non-standard PostgreSQL port avoiding potential collisions in case of local execution (e.g. via act)
# NOTE 2026-08-16: Manually change to port of local PostgreSQL installation for "just build" etc.
BUILD_DB_PORT=5433
BUILD_DB_NAME=myFancyDatabaseName
BUILD_DB_USER=testuser
BUILD_DB_PASSWORD=prettySafePassword

# The URL is implicitly required at least by diesel during building and sqlx (online mode) during testing
DATABASE_URL=${BUILD_DB_PROTOCOL}://${BUILD_DB_USER}:${BUILD_DB_PASSWORD}@${BUILD_DB_HOST}:${BUILD_DB_PORT}/${BUILD_DB_NAME}

# This path is ignored by GitHub actions but not by VSCode tasks calling just
PATH=~/.cargo/bin:$PATH